# Node artifact files
node_modules/
dist/
.engine/
.env
.env.local
.env.*.local
coverage/
test-results/
playwright-report/
PLAN.md
todos.yaml
developer_metadata.json
publish_manifest.yaml
test_report.yaml
graphify-out/cache/
graphify-out/cost.json

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

